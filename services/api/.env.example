DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
PORT=4000

# Canonical public MagCharge web URL used as the Paystack return destination.
MAGCHARGE_WEB_URL=https://YOUR-MAGCHARGE-WEB-URL

# Paystack server-side hosted checkout. Keep Live disabled until approved.
PAYSTACK_ENVIRONMENT=test
PAYSTACK_TEST_SECRET_KEY=sk_test_replace_with_test_secret
PAYSTACK_LIVE_SECRET_KEY=
PAYSTACK_LIVE_ENABLED=false

# Legacy Test-only fallback; prefer PAYSTACK_TEST_SECRET_KEY.
# PAYSTACK_SECRET_KEY=sk_test_replace_with_test_secret
